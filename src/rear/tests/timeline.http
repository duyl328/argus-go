      "date": "2024-10-05",
      "count": 1202
    },
    {
      "date": "2024-11-01",
      "count": 1
    },
    {
      "date": "2024-11-04",
      "count": 4
    },
    {
      "date": "2025-08-02",
      "count": 3
    }
  ]
}
